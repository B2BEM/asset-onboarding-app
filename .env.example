# Server
PORT=8080
NODE_ENV=production

# Auth mode behind the requireUser/requireAdmin seam (README §6)
# dev  = auto-authenticate every request as a fake admin user (no login flow)
# oidc = Active Directory SSO via OIDC (ADFS or Entra ID / Azure AD)
# saml / iwa = documented stubs, not implemented
# NOTE: with NODE_ENV=production the server REFUSES to start in dev mode unless
# ALLOW_DEV_AUTH_IN_PROD=true is set — dev mode gives every visitor admin access.
AUTH_MODE=oidc

# OIDC (required when AUTH_MODE=oidc). Works with ADFS or Entra ID.
# TODO IT: confirm federation type, issuer URL, app registration, and AD group names.
#OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=https://asset-onboarding.internal.example/auth/callback
#OIDC_SCOPES=openid profile email groups
# AD security group whose members get the app 'admin' role (everyone else: 'user')
#ADMIN_AD_GROUP=Asset-Onboarding-Admins
# Allow http:// issuer — local mock/testing ONLY, never in production
#OIDC_ALLOW_INSECURE=false

# express-session — REQUIRED in production; the server refuses to start with this
# blank or left at the old placeholder. Generate a value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Session cookie is Secure by default when NODE_ENV=production (TLS is terminated by
# nginx; TRUST_PROXY=1 in docker-compose makes the scheme visible to Express).
# Only set this to false for a deliberately plain-HTTP deployment.
#FORCE_HTTPS_COOKIE=true

# SQLite (paths relative to repo root; mount /data as a volume in production)
DB_PATH=data/app.db
SESSIONS_DB_PATH=data/sessions.db
